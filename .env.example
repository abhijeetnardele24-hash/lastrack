# LastRack Server Environment Configuration
# Placeholders only. Never commit real keys or secrets to version control.

# Server Port (default 3001)
PORT=3001
HOST=0.0.0.0

# Qloo API Credential
# Provided by Qloo hackathon organizers or developer portal
# Required for live Qloo MCP execution. When omitted, server runs with labeled DEMO_FIXTURE mode.
QLOO_API_KEY=your_qloo_api_key_here

# Client Origin (CORS allowlist for development)
CLIENT_ORIGIN=http://localhost:5173

# Node Environment (development | production | test)
NODE_ENV=development
